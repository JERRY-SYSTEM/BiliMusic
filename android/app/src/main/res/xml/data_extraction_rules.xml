<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in BiliBeat is worth restoring: downloads are re-downloaded and
     playlists re-created by hand. Opt everything out so no cached audio or
     credentials ever leak through a device-to-device migration. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>